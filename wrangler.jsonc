{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "appstore-free",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "headers": [
      {
        "path": "/index.html",
        "headers": [{ "name": "Cache-Control", "value": "no-store" }]
      },
      {
        "path": "/data/*",
        "headers": [{ "name": "Cache-Control", "value": "public, max-age=300, must-revalidate" }]
      },
      {
        "path": "/*",
        "headers": [
          { "name": "X-Frame-Options", "value": "DENY" },
          { "name": "X-Content-Type-Options", "value": "nosniff" },
          { "name": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "appstore-free",
      "database_id": "407161a3-7f21-4246-b208-f0df54779250"
    }
  ],
  "routes": [
    {
      "pattern": "freeapp.laowe.club/*",
      "zone_id": "610438506e5de561b5151f12b19fa991"
    }
  ],
  "workers_dev": true
}
